// ================================================================
// ZeroOne Self Compiler Bootstrap - v2.0.9
// ================================================================
//
// This is SOURCE ONLY on purpose.
// It is a ZeroOne-written bootstrap compiler for the core language:
//   SET name = literal
//   OUT expression
// and arithmetic expressions containing + - * / %.
//
// It emits a simple stack-oriented .zasm intermediate representation.
// The Python compiler can later be replaced piece by piece by this file.
// ================================================================

FUNC isSpace(ch)
    RETURN ISSPACE(ch)
END

FUNC trimLine(line)
    RETURN TRIM(line)
END

FUNC startsWith(line, word)
    RETURN STARTSWITH(line, word)
END

FUNC emitPush(value)
    RETURN "PUSH " + value
END

FUNC emitBinary(op)
    RETURN "OP " + op
END

FUNC splitExpression(expr)
    SET result = []
    SET current = ""
    SET i = 0
    SET depth = 0
    SET length = LENGTH(expr)

    WHILE i < length
        SET ch = CHARAT(expr, i)

        WHEN ch == "("
            SET depth = depth + 1
            SET current = current + ch
        ELSE
            WHEN ch == ")"
                SET depth = depth - 1
                SET current = current + ch
            ELSE
                WHEN depth == 0 AND (ch == "+" OR ch == "-" OR ch == "*" OR ch == "/" OR ch == "%")
                    WHEN LENGTH(TRIM(current)) > 0
                        PUSH(result, TRIM(current))
                    END
                    PUSH(result, ch)
                    SET current = ""
                ELSE
                    SET current = current + ch
                END
            END
        END

        SET i = i + 1
    END

    WHEN LENGTH(TRIM(current)) > 0
        PUSH(result, TRIM(current))
    END

    RETURN result
END

FUNC compileLiteral(token)
    SET t = TRIM(token)

    WHEN LENGTH(t) == 0
        RETURN "PUSH null"
    END

    WHEN STARTSWITH(t, "\"")
        RETURN emitPush(t)
    END

    WHEN ISDIGIT(CHARAT(t, 0))
        RETURN emitPush(t)
    END

    RETURN "LOAD " + t
END

FUNC compileExpression(expr)
    SET parts = splitExpression(expr)
    SET output = ""
    SET i = 0

    WHILE i < LENGTH(parts)
        SET part = parts[i]
        WHEN part == "+" OR part == "-" OR part == "*" OR part == "/" OR part == "%"
            SET output = output + emitBinary(part) + "\n"
        ELSE
            SET output = output + compileLiteral(part) + "\n"
        END
        SET i = i + 1
    END

    RETURN output
END

FUNC compileLine(line)
    SET s = trimLine(line)

    WHEN LENGTH(s) == 0
        RETURN ""
    END

    WHEN STARTSWITH(s, "//")
        RETURN ""
    END

    WHEN startsWith(s, "SET ")
        SET body = SUBSTR(s, 4)
        SET eq = STR_INDEXOF(body, "=")
        WHEN eq >= 0
            SET name = TRIM(SUBSTR(body, 0, eq))
            SET expr = TRIM(SUBSTR(body, eq + 1))
            RETURN compileExpression(expr) + "STORE " + name + "\n"
        END
        THROW "Invalid SET statement"
    END

    WHEN startsWith(s, "OUT ")
        SET expr = TRIM(SUBSTR(s, 4))
        RETURN compileExpression(expr) + "PRINT\n"
    END

    WHEN s == "OUT"
        RETURN "PUSH null\nPRINT\n"
    END

    RETURN ""
END

FUNC compileSource(source)
    SET lines = SPLIT(source, "\n")
    SET output = "; ZeroOne bootstrap assembly\n"
    SET output = output + "; generated by self_hosting/self_compiler.zo\n"
    SET i = 0

    WHILE i < LENGTH(lines)
        SET output = output + compileLine(lines[i])
        SET i = i + 1
    END

    RETURN output
END

FUNC compileFile(inputPath, outputPath)
    SET source = READ_FILE(inputPath)
    SET assembly = compileSource(source)
    WRITE_FILE(outputPath, assembly)
    RETURN outputPath
END

// Built-in demo: compile a tiny ZeroOne program.
SET demo = "SET x = 10\nOUT x + 5"
SET result = compileSource(demo)
OUT result

EXPORT isSpace, trimLine, startsWith, compileExpression, compileLine, compileSource, compileFile
